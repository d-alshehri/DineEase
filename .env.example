# Example settings for DineEase.
# HOW TO USE: copy this file and name the copy ".env", then put in your OWN values.
# .env is listed in .gitignore, so your real password is never committed to GitHub.
# Never put a real password in THIS file, because this file IS committed.

# MySQL server address (localhost = your own computer)
DB_HOST=localhost
# MySQL user name
DB_USER=root
# Your own MySQL password
DB_PASSWORD=your_mysql_password
# Database created by sql/schema.sql
DB_NAME=dineease

# Port the Express server listens on (http://localhost:3000)
PORT=3000
