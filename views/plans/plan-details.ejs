<!DOCTYPE html>
<html lang="en">
<%- include("../partials/head.ejs") %>

<body>
  <%- include("../partials/nav.ejs") %>

  <main class="container">
    <section class="page-intro" aria-labelledby="page-title">
      <p class="eyebrow">RESTAURANT SUBSCRIPTIONS</p>
      <h1 id="page-title">Find the right plan for your restaurant.</h1>
      <p class="lead">From your first digital menu to advanced reservation management, DineEase helps your business
        grow.</p>
    </section>

    <section aria-labelledby="plans-title">
      <div class="section-heading">
        <h2 id="plans-title">Available plans</h2>
        <a class="button button-primary" href="/plans/add">+ Add New Plan</a>
      </div>

      <%# Messages from public/js/delete-buttons.js (e.g. "Plan deleted.") %>
      <p id="list-status" class="form-message" role="status" aria-live="polite"></p>

      <%# "plans" comes from MySQL: the GET /plans route in routes/pages.js reads it and passes it here %>
      <% if (plans.length === 0) { %>
        <p id="plan-empty" class="empty-state">No plans yet. Add your first plan to get started.</p>
      <% } else { %>
        <div class="plan-grid" id="plan-list">
          <% plans.forEach(plan => { %>
            <%# data-item marks one thing that a Delete button can remove from the page %>
            <article class="plan-card<%= plan.category === 'Premium' ? ' featured' : '' %>" data-item>
              <span class="plan-tag"><%= plan.category %></span>
              <h3><%= plan.name %></h3>
              <%# MySQL sends DECIMAL as text ("49.00"), so we use Number() before toFixed(2) %>
              <p class="price"><%= Number(plan.price).toFixed(2) %> SAR <small>/ <%= plan.duration === 'Yearly' ? 'year' : 'month' %></small></p>
              <p class="plan-description"><%= plan.description %></p>
              <ul class="plan-features">
                <li>Up to <%= plan.menu_limit %> menu items</li>
                <li><%= plan.reservations ? 'Online table reservations included' : 'Digital menu display' %></li>
                <li>Easy price updates</li>
              </ul>
              <p class="plan-meta">Available from: <%= plan.start_date_label %></p>

              <%# Edit opens the form filled with this plan. Delete first asks "are you sure?" on the page itself. %>
              <div class="item-actions" data-actions>
                <a class="button button-secondary" href="/plans/<%= plan.id %>/edit">Edit</a>
                <button type="button" class="button button-danger" data-show-confirm>Delete</button>
              </div>
              <div class="confirm-delete" data-confirm hidden>
                <p>Delete the plan "<%= plan.name %>"? This cannot be undone.</p>
                <div class="item-actions">
                  <button type="button" class="button button-secondary" data-cancel>Cancel</button>
                  <button type="button" class="button button-danger" data-delete-url="/api/plans/<%= plan.id %>">Yes, delete</button>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>

    <section class="info-panel" aria-labelledby="about-plans-title">
      <h2 id="about-plans-title">Why DineEase?</h2>
      <p>Make your menu easy to browse, keep your prices up to date, and give customers a convenient way to reserve a
        table before they visit.</p>
    </section>
  </main>

  <%- include("../partials/footer.ejs") %>

  <script src="/js/delete-buttons.js"></script>
</body>

</html>
