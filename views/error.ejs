<!DOCTYPE html>
<html lang="en">
<%# Shown by the error-handling middleware in server.js when a page route fails (status 500) %>
<%- include("./partials/head.ejs") %>

<body>
    <%- include("./partials/nav.ejs") %>

    <main class="container narrow">
        <section class="page-intro" aria-labelledby="page-title">
            <p class="eyebrow">ERROR 500</p>
            <h1 id="page-title">Something went wrong.</h1>
            <p class="lead">Sorry, there was a problem on our server. Please try again later.</p>
            <div class="intro-actions">
                <a href="/" class="button button-primary">Back to Home</a>
            </div>
        </section>
    </main>

    <%- include("./partials/footer.ejs") %>
</body>

</html>
