<!DOCTYPE html>
<html lang="en">
<%- include("../partials/head.ejs") %>

<body>
    <%- include("../partials/nav.ejs") %>

    <h1>Log In</h1>

    <%# No "action": public/js/login.js sends the form to /api/profiles/login with fetch() %>
    <form id="login-form" class="user-form login-form">

        <fieldset>
            <legend>Welcome back</legend>

            <div class="form-grid">
                <div class="field full">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" placeholder="name@example.com" required>
                </div>

                <div class="field full">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" minlength="8" title="At least 8 characters" required>
                </div>
            </div>

            <%# login.js writes success / error messages here %>
            <p id="form-message" role="alert"></p>

            <div class="button-row">
                <button type="submit" class="button">Log In</button>
            </div>

            <a href="/signup" class="add-user-button">Don't have an account? Sign up</a>
        </fieldset>

    </form>


    <%- include("../partials/footer.ejs") %>

    <script src="/js/login.js"></script>
</body>

</html>
