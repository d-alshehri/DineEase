<!DOCTYPE html>
<html lang="en">
<%- include("../partials/head.ejs") %>

<body>
    <%- include("../partials/nav.ejs") %>

    <main class="container small">
        <section class="page-intro" aria-labelledby="page-title">
            <p class="eyebrow">MY ACCOUNT</p>
            <h1 id="page-title">Welcome back.</h1>
            <p class="lead">Log in to manage your restaurant, plan and reservations.</p>
        </section>

        <section class="form-card" aria-labelledby="form-title">
            <h2 id="form-title">Log In</h2>
            <p class="muted">Fields marked * are required.</p>

            <%# No "action": public/js/login.js sends the form to /api/profiles/login with fetch() %>
            <form id="login-form">
                <div class="form-grid">
                    <div class="field full">
                        <label for="email">Email *</label>
                        <input type="email" id="email" name="email" placeholder="name@example.com" required>
                    </div>

                    <div class="field full">
                        <label for="password">Password *</label>
                        <input type="password" id="password" name="password" minlength="8" title="At least 8 characters" required>
                    </div>
                </div>

                <%# login.js writes success / error messages here %>
                <p id="form-message" class="form-message" role="alert"></p>

                <div class="form-actions">
                    <button type="submit" class="button button-primary">Log In</button>
                </div>
            </form>

            <p class="form-switch">Don't have an account? <a href="/signup">Sign up</a></p>
        </section>
    </main>

    <%- include("../partials/footer.ejs") %>

    <script src="/js/login.js"></script>
</body>

</html>
