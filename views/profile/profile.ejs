<!DOCTYPE html>
<html lang="en">
<%- include("../partials/head.ejs") %>

<body>

    <%- include("../partials/nav.ejs") %>

    <section class="page-header">
        <p class="subtitle">MY ACCOUNT</p>
        <h2>Profile Page</h2>
        <p>Manage your restaurant details, plan and recent activity.</p>
    </section>

    <%# "user" comes from the database (see the GET /profile route in routes/pages.js) %>
    <section class="dashboard">
        <h2>Welcome back, <%= user.full_name %></h2>

        <div class="dashboard-grid">
            <article class="dash-card">
                <h3>Account details</h3>
                <p><strong>Email:</strong> <%= user.email %></p>
                <p><strong>Phone:</strong> <%= user.phone %></p>
                <p><strong>Restaurant:</strong> <%= user.restaurant_name || 'Not added yet' %></p>
            </article>

            <article class="dash-card">
                <h3>Current plan</h3>
                <% if (user.plan_name) { %>
                    <p><strong><%= user.plan_name %></strong> - SAR <%= Number(user.plan_price) %> / <%= user.plan_duration === 'Yearly' ? 'year' : 'month' %></p>
                <% } else { %>
                    <p>No plan selected yet</p>
                <% } %>
                <a href="/plans">View plan details</a>
            </article>

            <%# SAMPLE DATA: the "This month" card and the reservations table below are
                not in the database yet, so they are still the Phase 1 example values. %>
            <article class="dash-card">
                <h3>This month</h3>
                <p><strong>42</strong> reservations</p>
                <p><strong>128</strong> menu items</p>
            </article>
        </div>

        <h3>Recent reservations</h3>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Guest</th>
                        <th>Date</th>
                        <th>Guests</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Sara Khalid</td>
                        <td>27 Oct 2026</td>
                        <td>4</td>
                        <td>Confirmed</td>
                    </tr>
                    <tr>
                        <td>Omar Hassan</td>
                        <td>28 Oct 2026</td>
                        <td>2</td>
                        <td>Confirmed</td>
                    </tr>
                    <tr>
                        <td>Lina Yousef</td>
                        <td>29 Oct 2026</td>
                        <td>6</td>
                        <td>Pending</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
    <button type="button" class="button" onclick="window.location.href='/login'">Log Out</button>
    <%- include("../partials/footer.ejs") %>
</body>

</html>
