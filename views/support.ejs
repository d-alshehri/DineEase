<!DOCTYPE html>
<html lang="en">
<%- include("./partials/head.ejs") %>

<body>

    <%- include("./partials/nav.ejs") %>

    <main class="container narrow">

        <section class="page-intro" aria-labelledby="page-title">
            <p class="eyebrow">HELP CENTER</p>
            <h1 id="page-title">Feedback &amp; Support</h1>
            <p class="lead">
                We are here to help you! Send us your questions,
                suggestions, or feedback.
            </p>
        </section>

        <!-- Feedback form (feedback-api.js) -->
        <section class="form-card" aria-labelledby="feedback-title">

            <h2 id="feedback-title">Send us a message</h2>
            <p class="muted">All fields are required.</p>

            <%# sent: after a successful send (/support?sent=1) %>
            <% if (sent) { %>
                <p class="form-message" role="status">Thank you! Your feedback was submitted successfully.</p>
            <% } %>

            <form id="feedbackForm">

                <div class="form-grid">

                    <div class="field">
                        <label for="name">Name</label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder="Enter your name"
                            required
                            minlength="2"
                            maxlength="100"
                        >
                    </div>

                    <div class="field">
                        <label for="email">Email</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="Enter your email"
                            required
                            maxlength="255"
                        >
                    </div>

                    <div class="field full">
                        <label for="subject">Subject</label>
                        <input
                            type="text"
                            id="subject"
                            name="subject"
                            placeholder="Enter the subject"
                            required
                            maxlength="200"
                        >
                    </div>

                    <div class="field full">
                        <label for="message">Message</label>
                        <textarea
                            id="message"
                            name="message"
                            rows="5"
                            placeholder="Write your message here..."
                            required
                            minlength="10"
                            maxlength="5000"
                        ></textarea>
                    </div>

                </div>

                <p id="feedback-message" class="form-message" role="status" aria-live="polite"></p>

                <div class="form-actions">
                    <button type="submit" class="button button-primary">Send Message</button>
                </div>

            </form>

        </section>


        <!-- Recent feedback from MySQL, with keyword search -->
        <section class="form-card" id="recent-feedback" aria-labelledby="recent-title">

            <h2 id="recent-title">Recent feedback</h2>
            <p class="muted">Messages sent by our customers, newest first.</p>

            <%# GET form: the /support route reads ?keyword= and filters the list %>
            <form method="get" action="/support" class="search-form" role="search">
                <div class="field">
                    <label for="keyword">Search feedback by keyword</label>
                    <input
                        type="search"
                        id="keyword"
                        name="keyword"
                        value="<%= keyword %>"
                        placeholder="e.g. menu, reservation, price..."
                        maxlength="200"
                    >
                </div>
                <button type="submit" class="button button-primary">Search</button>
                <% if (keyword) { %>
                    <a class="button button-secondary" href="/support">Clear search</a>
                <% } %>
            </form>

            <%# message after a delete (delete-buttons.js) %>
            <p id="list-status" class="form-message" role="status" aria-live="polite"></p>

            <% if (keyword && feedback.length > 0) { %>
                <p class="muted">Showing <%= feedback.length %> result<%= feedback.length === 1 ? '' : 's' %> for "<%= keyword %>".</p>
            <% } %>

            <% if (feedback.length === 0) { %>
                <p class="empty-state">
                    <%= keyword ? `No feedback matches '${keyword}'.` : 'No feedback yet. Be the first to send us a message!' %>
                </p>
            <% } else { %>
                <ul class="feedback-list">
                    <% feedback.forEach(item => { %>
                        <li class="feedback-item" data-item>
                            <div class="feedback-header">
                                <strong><%= item.name %></strong>
                                <span class="feedback-date"><%= item.date_label %></span>
                            </div>
                            <p class="feedback-subject"><%= item.subject %></p>
                            <p class="feedback-text"><%= item.message %></p>

                            <div class="item-actions" data-actions>
                                <button type="button" class="button button-danger" data-show-confirm>Delete</button>
                            </div>
                            <div class="confirm-delete" data-confirm hidden>
                                <p>Delete this feedback from <%= item.name %>? This cannot be undone.</p>
                                <div class="item-actions">
                                    <button type="button" class="button button-secondary" data-cancel>Cancel</button>
                                    <button type="button" class="button button-danger" data-delete-url="/api/feedback/<%= item.id %>">Yes, delete</button>
                                </div>
                            </div>
                        </li>
                    <% }) %>
                </ul>
            <% } %>

        </section>


        <!-- Search the real plans (feedback-api.js, GET /api/plans) -->
        <section class="form-card" aria-labelledby="search-title">

            <h2 id="search-title">Search Plans</h2>
            <p class="muted">Search the real DineEase subscription plans saved in our database.</p>

            <form id="searchForm" class="search-form">

                <div class="field">
                    <label for="searchInput">Plan Name</label>
                    <input
                        type="text"
                        id="searchInput"
                        name="search"
                        placeholder="Enter plan name..."
                        required
                    >
                </div>

                <button type="submit" class="button button-primary">Search</button>

            </form>

            <div class="table-wrap search-results">

                <table>
                    <thead>
                        <tr>
                            <th>Plan Name</th>
                            <th>Price</th>
                            <th>Duration</th>
                        </tr>
                    </thead>

                    <tbody id="results" aria-live="polite">
                        <tr>
                            <td colspan="3">
                                Search for a plan to see results.
                            </td>
                        </tr>
                    </tbody>

                </table>

            </div>

        </section>


        <!-- Phase 1 requirement: search dummy data from a JS file (search.js) -->
        <section class="form-card" aria-labelledby="demo-search-title">

            <h2 id="demo-search-title">Sample Plans Search (Phase 1 demo)</h2>
            <p class="muted">
                This search uses sample data stored in a JavaScript file (public/js/search.js),
                not the database. It shows the Phase 1 search feature.
            </p>

            <form id="demoSearchForm" class="search-form">

                <div class="field">
                    <label for="demoSearchInput">Sample plan name</label>
                    <input
                        type="text"
                        id="demoSearchInput"
                        name="demoSearch"
                        placeholder="e.g. Starter, Professional, Premium"
                        required
                    >
                </div>

                <button type="submit" class="button button-secondary">Search samples</button>

            </form>

            <div class="table-wrap search-results">

                <table>
                    <thead>
                        <tr>
                            <th>Plan Name</th>
                            <th>Price</th>
                            <th>Duration</th>
                        </tr>
                    </thead>

                    <tbody id="demoResults" aria-live="polite">
                        <tr>
                            <td colspan="3">
                                Search the sample plans to see results.
                            </td>
                        </tr>
                    </tbody>

                </table>

            </div>

        </section>

    </main>

    <%- include("./partials/footer.ejs") %>

    <script src="/js/feedback-api.js"></script>
    <script src="/js/search.js"></script>
    <script src="/js/delete-buttons.js"></script>

</body>
</html>
