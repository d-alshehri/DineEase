<%# Variables: title, and an optional styles array for page CSS.
    locals.styles is used so pages that don't pass styles don't crash. %>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="DineEase helps restaurants and cafes display menus, prices, and table reservations.">

    <title>DineEase - <%= title %></title>

    <link rel="stylesheet" href="/css/style.css">

    <% if (locals.styles) { %>
        <% locals.styles.forEach((file) => { %>
    <link rel="stylesheet" href="<%= file %>">
        <% }) %>
    <% } %>
</head>
