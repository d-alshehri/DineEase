<%# Shared navigation bar for every EJS page.
    Variable: active (optional). It names the current page: 'home', 'plans', 'add-plan', 'support' or 'profile'.
    current('plans') returns the attributes that highlight a link when it is the current page:
      class="active"         -> the CSS underlines it (style.css)
      aria-current="page"    -> screen readers say "current page"
    We use locals.active so pages that do not pass "active" do not crash. %>
<% const current = (name) => (locals.active === name ? 'class="active" aria-current="page"' : ''); %>
<header class="site-header">
    <nav class="nav container" aria-label="Main navigation">
        <a class="brand" href="/">DineEase<span class="brand-dot">.</span></a>

        <ul class="nav-links">
            <li><a href="/" <%- current('home') %>>Home</a></li>
            <li><a href="/#features">Features</a></li>
            <li><a href="/#pricing">Pricing</a></li>
            <li><a href="/plans" <%- current('plans') %>>Plans</a></li>
            <li><a href="/plans/add" <%- current('add-plan') %>>Add Plan</a></li>
            <li><a href="/support" <%- current('support') %>>Support</a></li>
            <li><a href="/login" <%- current('profile') %>>Profile</a></li>
        </ul>
    </nav>
</header>
