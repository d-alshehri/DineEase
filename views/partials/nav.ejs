<%# Shared navigation bar for every EJS page.
    Variable: active (optional). It names the current page: 'home', 'plans', 'add-plan', 'support' or 'profile'.
    The link of the current page gets class="active", so it is highlighted. %>
<header>
    <nav class="navbar">
        <a href="/" class="logo">DineEase</a>

        <ul class="nav-links">
            <li><a href="/" class="<%= locals.active === 'home' ? 'active' : '' %>">Home</a></li>
            <li><a href="/#features">Features</a></li>
            <li><a href="/#pricing">Pricing</a></li>
            <li><a href="/plans" class="<%= locals.active === 'plans' ? 'active' : '' %>">Plans</a></li>
            <li><a href="/plans/add" class="<%= locals.active === 'add-plan' ? 'active' : '' %>">Add Plan</a></li>
            <li><a href="/support" class="<%= locals.active === 'support' ? 'active' : '' %>">Support</a></li>
            <li><a href="/login" class="<%= locals.active === 'profile' ? 'active' : '' %>">Profile</a></li>
        </ul>
    </nav>
</header>
